{
  "name": "ats-crm-backend-v2",
  "version": "1.0.0",
  "description": "Unified backend for ATS and CRM platform",
  "main": "dist/app.js",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed:admin": "ts-node src/scripts/seed-admin.ts",
    "seed:demo": "ts-node src/scripts/seed-demo.ts",
    "seed:disposition-reasons": "ts-node src/scripts/seed-disposition-reasons.ts",
    "migrate:user-permissions": "ts-node src/scripts/migrate-user-permissions.ts",
    "migrate:company-timezone": "ts-node src/scripts/migrate-company-timezone.ts",
    "migrate:email-sender": "ts-node --transpile-only src/scripts/align-email-sender.ts",
    "migrate:eod-time": "ts-node src/scripts/migrate-eod-time.ts",
    "migrate:activity-action": "ts-node --transpile-only src/scripts/migrate-activity-action.ts",
    "migrate:activity-timestamps": "ts-node --transpile-only src/scripts/migrate-activity-timestamps.ts",
    "backfill:activity-performers": "ts-node --transpile-only src/scripts/backfill-activity-performers.ts",
    "dedupe:activity-logs": "ts-node --transpile-only src/scripts/dedupe-activity-logs.ts",
    "cleanup:activity-indexes": "ts-node --transpile-only src/scripts/cleanup-activity-indexes.ts"
  },
  "dependencies": {
    "@sentry/node": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.13.0",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "resend": "^6.4.0-canary.0",
    "sanitize-html": "^2.18.0",
    "socket.io": "^4.8.4",
    "svix": "^1.96.1",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/winston": "^2.4.4",
    "@types/xlsx": "^0.0.36",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "engine.io@>=6.6.0 <6.6.10": "^6.6.10",
      "socket.io-parser@>=4.0.0 <4.2.7": "^4.2.7",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": "^0.8.15",
      "proxy-addr@>=1.1.0 <2.0.8": "^2.0.8",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
    }
  }
}
